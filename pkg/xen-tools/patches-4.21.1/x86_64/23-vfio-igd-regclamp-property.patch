From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Renê de Souza Pinto <rene@renesp.com.br>
Date: Thu, 8 Oct 2026 12:00:00 +0000
Subject: [PATCH] vfio/igd: make the power-management register clamps opt-in

Patches 18-22 install BAR0 quirks on every gen9+ assigned iGPU that deny or
override guest writes to DC_STATE_EN, the display power-well controls
(PWR_WELL_CTL, AUX, DDI), GEN6_RC_CONTROL and POWERGATE_ENABLE. They work
around a silent host wedge seen on some hosts, but they cost iGPU idle power,
trap extra BAR0 pages (vmexits on the forcewake page when mmap is enabled),
and holding the DDI/PHY wells on can interfere with port re-training. Hosts
that do not exhibit the wedge should not pay for that.

Add a vfio-pci property, x-igd-regclamp (bool, default off), and install
those five clamps only when it is on. The DBUF_CTL sanitize quirk and the
BDSM mirror are unaffected.

Signed-off-by: Renê de Souza Pinto <rene@renesp.com.br>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/vfio/igd.c | 17 ++++++++++++-----
 hw/vfio/pci.c |  1 +
 hw/vfio/pci.h |  1 +
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/tools/qemu-xen/hw/vfio/igd.c b/tools/qemu-xen/hw/vfio/igd.c
index a0985b2..af8d64b 100644
--- a/tools/qemu-xen/hw/vfio/igd.c
+++ b/tools/qemu-xen/hw/vfio/igd.c
@@ -849,12 +849,19 @@ void vfio_probe_igd_bar0_quirk(VFIOPCIDevice *vdev, int nr)
         }
     }
 
+    /*
+     * The register clamps below (DC_STATE_EN, display power wells, RC6 and
+     * slice power-gating) trade iGPU idle power for not letting the guest
+     * race a powered-down block, which wedges some hosts.  They are opt-in:
+     * only installed when the device is created with x-igd-regclamp=on.
+     */
+
     /*
      * DC_STATE_EN clamp (gen9+, where DC states were introduced): refuse to
      * let the guest power the display engine down into a DC state it cannot
      * be brought back out of.  See igd_dc_state_write().
      */
-    if (gen >= 9) {
+    if (gen >= 9 && vdev->igd_regclamp) {
         VFIOQuirk *dcquirk = vfio_quirk_alloc(1);
         IGDDcStateQuirk *dq = dcquirk->data = g_malloc0(sizeof(*dq));
 
@@ -876,7 +883,7 @@ void vfio_probe_igd_bar0_quirk(VFIOPCIDevice *vdev, int nr)
      * a well that is off or mid-transition and wedges the host.  See
      * igd_pwr_well_write().
      */
-    if (gen >= 9) {
+    if (gen >= 9 && vdev->igd_regclamp) {
         VFIOQuirk *pwquirk = vfio_quirk_alloc(1);
         IGDPwrWellQuirk *pq = pwquirk->data = g_malloc0(sizeof(*pq));
 
@@ -902,7 +909,7 @@ void vfio_probe_igd_bar0_quirk(VFIOPCIDevice *vdev, int nr)
      * next boot - verify the display returns after a guest reboot; if not, drop
      * 0x45454 and keep only AUX.
      */
-    if (gen >= 9) {
+    if (gen >= 9 && vdev->igd_regclamp) {
         static const uint32_t igd_pwr_well_aux_ddi[] = { 0x45444, 0x45454 };
         unsigned k;
 
@@ -928,7 +935,7 @@ void vfio_probe_igd_bar0_quirk(VFIOPCIDevice *vdev, int nr)
      * render power-gating, so the GT stays awake and an MMIO access cannot race
      * an RC6 wake.  See igd_rc6_write().
      */
-    if (gen >= 9) {
+    if (gen >= 9 && vdev->igd_regclamp) {
         VFIOQuirk *rcquirk = vfio_quirk_alloc(1);
         IGDPwrWellQuirk *rq = rcquirk->data = g_malloc0(sizeof(*rq));
 
@@ -949,7 +956,7 @@ void vfio_probe_igd_bar0_quirk(VFIOPCIDevice *vdev, int nr)
      * render/media slice power-gating, so those engines stay awake and an MMIO
      * access cannot race a slice power-gate.  See igd_pg_enable_write().
      */
-    if (gen >= 9) {
+    if (gen >= 9 && vdev->igd_regclamp) {
         VFIOQuirk *pgquirk = vfio_quirk_alloc(1);
         IGDPwrWellQuirk *pq = pgquirk->data = g_malloc0(sizeof(*pq));
 
diff --git a/tools/qemu-xen/hw/vfio/pci.c b/tools/qemu-xen/hw/vfio/pci.c
index 9069c67..5d1c584 100644
--- a/tools/qemu-xen/hw/vfio/pci.c
+++ b/tools/qemu-xen/hw/vfio/pci.c
@@ -3399,6 +3399,7 @@ static Property vfio_pci_dev_properties[] = {
     DEFINE_PROP_UINT32("x-pci-sub-device-id", VFIOPCIDevice,
                        sub_device_id, PCI_ANY_ID),
     DEFINE_PROP_UINT32("x-igd-gms", VFIOPCIDevice, igd_gms, 0),
+    DEFINE_PROP_BOOL("x-igd-regclamp", VFIOPCIDevice, igd_regclamp, false),
     DEFINE_PROP_UNSIGNED_NODEFAULT("x-nv-gpudirect-clique", VFIOPCIDevice,
                                    nv_gpudirect_clique,
                                    qdev_prop_nv_gpudirect_clique, uint8_t),
diff --git a/tools/qemu-xen/hw/vfio/pci.h b/tools/qemu-xen/hw/vfio/pci.h
index 5ad090a..a94886c 100644
--- a/tools/qemu-xen/hw/vfio/pci.h
+++ b/tools/qemu-xen/hw/vfio/pci.h
@@ -159,6 +159,7 @@ struct VFIOPCIDevice {
     uint32_t display_yres;
     int32_t bootindex;
     uint32_t igd_gms;
+    bool igd_regclamp;
     OffAutoPCIBAR msix_relo;
     uint8_t pm_cap;
     uint8_t nv_gpudirect_clique;
-- 
2.43.0
