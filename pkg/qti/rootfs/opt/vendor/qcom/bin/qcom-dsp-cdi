#!/bin/sh
# Copyright (c) 2026 Zededa, Inc.
# SPDX-License-Identifier: Apache-2.0
#
# Generate the CDI spec giving edge app containers access to the Hexagon DSPs
# (kind qualcomm.com/dsp), see pkg/qti/README.md.
#
# One CDI device per DSP with a FastRPC device node (/dev/fastrpc-<dsp>, plus
# its -secure node), named after it (adsp, cdsp, cdsp1, gdsp0, ...), and
# "all". Every device also gets the DMA heap FastRPC allocates buffers from,
# the glibc FastRPC client libraries (Debian's, with their dependencies) and
# the DSP libraries (shells, skels, conf.d) of /opt/vendor/qcom/dsp, mounted
# where Debian's FastRPC looks for them. FastRPC finds the board's DSP
# libraries through conf.d by the device tree model, which containers can't
# read (/sys/firmware is masked), so it's also passed in MACHINE_NAME, the
# FastRPC fallback.
#
# The DSPs show up asynchronously, as their remote processors boot, so the
# spec is regenerated whenever the set of FastRPC nodes changes, until
# <timeout> seconds elapse. Pillar's CDI registry picks up every update.
#
# Usage: qcom-dsp-cdi [timeout]
#
# Environment (for testing): DEV_DIR (default /dev), CDI_SPEC (default
# /run/cdi/qualcomm-dsp.yaml), VENDOR_DIR (default /opt/vendor/qcom),
# MODEL_FILE (default /sys/firmware/devicetree/base/model).

TIMEOUT="${1:-60}"
DEV_DIR="${DEV_DIR:-/dev}"
CDI_SPEC="${CDI_SPEC:-/run/cdi/qualcomm-dsp.yaml}"
VENDOR_DIR="${VENDOR_DIR:-/opt/vendor/qcom}"
MODEL_FILE="${MODEL_FILE:-/sys/firmware/devicetree/base/model}"
GLIBC_LIB="${VENDOR_DIR}/glibc/lib"
DSP_DIR="${VENDOR_DIR}/dsp"
# Where Debian/Ubuntu (arm64) look for libraries without an ld.so.cache entry
CONTAINER_LIB=/usr/lib/aarch64-linux-gnu
# FastRPC configuration base directory of Debian's libfastrpc1
CONTAINER_DSP=/usr/share/hexagon-dsp

log() {
    echo "qcom-dsp-cdi: $*"
}

# DSP names with a FastRPC node, e.g. "adsp cdsp cdsp1"
list_dsps() {
    for n in "${DEV_DIR}"/fastrpc-*; do
        [ -c "$n" ] || continue
        n="${n##*/fastrpc-}"
        echo "${n%-secure}"
    done | sort -u | tr '\n' ' '
}

# device_nodes <indent> <dsp>...
device_nodes() {
    indent="$1"
    shift
    echo "${indent}deviceNodes:"
    for d in "$@"; do
        for n in "${DEV_DIR}/fastrpc-$d" "${DEV_DIR}/fastrpc-$d-secure"; do
            if [ -c "$n" ]; then
                echo "${indent}  - path: /dev/${n#"${DEV_DIR}"/}"
            fi
        done
    done
}

mount_entry() {
    echo "    - hostPath: $1"
    echo "      containerPath: $2"
    echo "      options: [ro, nosuid, nodev, $3]"
}

# write_spec <dsp>...
write_spec() {
    {
        echo "# Generated by qcom-dsp-cdi, do not edit"
        echo "cdiVersion: 0.5.0"
        echo "kind: qualcomm.com/dsp"
        echo "containerEdits:"
        if [ -c "${DEV_DIR}/dma_heap/system" ]; then
            echo "  deviceNodes:"
            echo "    - path: /dev/dma_heap/system"
        fi
        machine=$(tr -d '\0' < "${MODEL_FILE}" 2>/dev/null | sed 's/[\\"]/\\&/g')
        if [ -n "$machine" ]; then
            echo "  env:"
            echo "    - \"MACHINE_NAME=${machine}\""
        fi
        echo "  mounts:"
        # Each library under its soname. The FastRPC ones also under their
        # unversioned name, which dlopen() users ask for (e.g. QNN's HTP
        # backend: libcdsprpc.so)
        for lib in "${GLIBC_LIB}"/lib*.so.[0-9]*; do
            [ -f "$lib" ] || continue
            soname="${lib##*/}"
            mount_entry "$lib" "${CONTAINER_LIB}/${soname}" bind
            case "$soname" in
                lib*dsprpc.so.*)
                    mount_entry "$lib" "${CONTAINER_LIB}/${soname%.so.*}.so" bind ;;
            esac
        done
        if [ -d "${DSP_DIR}" ]; then
            mount_entry "${DSP_DIR}" "${CONTAINER_DSP}" rbind
        fi
        echo "devices:"
        for d in "$@"; do
            echo "  - name: $d"
            echo "    containerEdits:"
            device_nodes "      " "$d"
        done
        echo "  - name: all"
        echo "    containerEdits:"
        device_nodes "      " "$@"
    } > "${CDI_SPEC}.tmp"
    mv "${CDI_SPEC}.tmp" "${CDI_SPEC}"
}

mkdir -p "$(dirname "${CDI_SPEC}")"
prev=""
i=0
while :; do
    dsps=$(list_dsps)
    if [ -n "$dsps" ] && [ "$dsps" != "$prev" ]; then
        # shellcheck disable=SC2086
        write_spec $dsps
        log "generated ${CDI_SPEC} for DSP(s): ${dsps% }"
        prev="$dsps"
    fi
    [ "$i" -lt "$TIMEOUT" ] || break
    sleep 1
    i=$((i + 1))
done
[ -n "$prev" ] || log "no FastRPC device found, no CDI spec generated"
