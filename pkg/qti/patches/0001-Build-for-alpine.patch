diff --git a/include/musl-compat.h b/include/musl-compat.h
new file mode 100644
index 000000000..95e56cee6
--- /dev/null
+++ b/include/musl-compat.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <sys/stat.h>
+#include <errno.h>
+#include <unistd.h>
+#include <grp.h>
+#include <string.h>
+#include <stdio.h>
+#include <openssl/evp.h>
+
+// sys/cdefs.h BSD compat macros
+#ifndef __BEGIN_DECLS
+#ifdef __cplusplus
+#define __BEGIN_DECLS extern "C" {
+#define __END_DECLS   }
+#else
+#define __BEGIN_DECLS
+#define __END_DECLS
+#endif
+#endif
+
+// Fix typeof -> __typeof__ for musl/strict C++ mode
+#ifndef typeof
+#define typeof __typeof__
+#endif
+
+// Override TEMP_FAILURE_RETRY with decltype-based version
+#ifdef TEMP_FAILURE_RETRY
+#undef TEMP_FAILURE_RETRY
+#endif
+#define TEMP_FAILURE_RETRY(exp)                    \
+    ({                                             \
+        decltype(exp) _rc;                         \
+        do { _rc = (exp); }                        \
+        while (_rc == -1 && errno == EINTR);       \
+        _rc;                                       \
+    })
+
+// BSD/glibc macros missing from musl
+#ifndef DEFFILEMODE
+#define DEFFILEMODE (S_IRUSR|S_IWUSR|S_IRGRP|S_IWGRP|S_IROTH|S_IWOTH)
+#endif
+
+// BSD/glibc function missing from musl
+#ifndef getprogname
+#define getprogname() program_invocation_short_name
+#endif
+
+// glibc-specific group membership check
+#ifndef group_member
+static inline int group_member(gid_t gid) {
+    if (getgid() == gid || getegid() == gid) return 1;
+    int ngroups = getgroups(0, NULL);
+    if (ngroups <= 0) return 0;
+    gid_t* groups = (gid_t*)alloca(ngroups * sizeof(gid_t));
+    if (getgroups(ngroups, groups) < 0) return 0;
+    for (int i = 0; i < ngroups; i++)
+        if (groups[i] == gid) return 1;
+    return 0;
+}
+#endif
+
+// BSD internal base64 decode via OpenSSL
+#ifndef __b64_pton
+static inline int __b64_pton(const char* src, unsigned char* dst, size_t dstlen) {
+    size_t srclen = strlen(src);
+    char* clean = (char*)alloca(srclen + 1);
+    size_t j = 0;
+    for (size_t i = 0; i < srclen; i++)
+        if (src[i] != '\n' && src[i] != '\r' && src[i] != ' ')
+            clean[j++] = src[i];
+    clean[j] = '\0';
+    int ret = EVP_DecodeBlock(dst, (const unsigned char*)clean, (int)j);
+    if (ret < 0) return -1;
+    if (j >= 2 && clean[j-1] == '=') ret--;
+    if (j >= 2 && clean[j-2] == '=') ret--;
+    return ret;
+}
+#endif
+
+// At the end of musl-compat.h, BEFORE properties.h gets included
+
+#ifndef PROP_VALUE_MAX
+#define PROP_VALUE_MAX 92
+#endif
+
