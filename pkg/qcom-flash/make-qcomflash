#
# Assemble a QDL flash bundle for a Qualcomm UFS device: the boot firmware and
# CDT of a Qualcomm reference board ("base", see prepare-base.sh), the board's
# own files on top of them, the GPT/QDL files generated with qcom-ptool, and
# EVE's own partition images built from the inputs in /parts.
#
# Usage: make-qcomflash <board> [output dir]
#
# Board: a directory (BOARD_DIR, default /board) with (see README.md):
#   board.conf     BASE=<base>: Qualcomm firmware/CDT/partition layout to start
#                  from, one of /qcom-flash/base/* (mandatory)
#   grub.cfg       board GRUB settings (optional)
#   grub-qcom.cfg  replaces the common /qcom-flash/grub-qcom.cfg (optional)
#   dtb/           device trees, copied to the ESP's /dtb (optional)
#   partitions/partitions.conf
#                  qcom-ptool layout for LUNs 1-5 (with the --disk line),
#                  replaces the base's one. LUN 0 is always EVE's (optional)
#   flash/         files copied into the bundle over the base's ones: same
#                  path replaces, otherwise added (optional)
#
# Inputs (/parts, the same directory used by mkimage-raw-efi):
#   EFI/         GRUB EFI binaries (mandatory)
#   boot/        extra files for the ESP root (optional)
#   rootfs.img   EVE rootfs, written to IMGA (mandatory)
#   config.img   CONFIG partition contents, FAT image (mandatory)
#   eve_version  EVE version, recorded in board.info (optional)
#   dtb.bin      multi-DTB FIT VFAT image for the dtb_a/dtb_b partitions
#                (optional, overrides the board's one; when there is none,
#                those partitions are not written). The DTB_BIN environment
#                variable can point to another path.
#
# The output directory (default /out) is flashed with:
#   qdl --storage ufs prog_firehose_ddr.elf rawprogram*.xml patch*.xml
#
# Builds with board data that differ from the base (flash/ files, partition
# layout, dtb.bin) are flagged as custom in /EFI/BOOT/board.info on the ESP and
# in bundle-manifest.txt/.json in the bundle.
#
set -e

BOARD="$1"
OUT="${2:-/out}"
PARTS=/parts
DTB_BIN="${DTB_BIN:-$PARTS/dtb.bin}"
FLASH_DIR=/qcom-flash
BOARD_DIR="${BOARD_DIR:-/board}"
SECTOR=4096
# Sizes of EVE's FAT partitions in KB, they must match eve-lun0.conf
EFI_PART_KB=2097152
CONF_PART_KB=5120

bail() {
    echo "make-qcomflash: ERROR: $*" >&2
    exit 1
}

list_dirs() {
    find "$1" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | tr '\n' ' '
}

if [ -z "$BOARD" ] || [ ! -f "$BOARD_DIR/board.conf" ]; then
    echo "Usage: $0 <board> [output dir]" >&2
    [ -n "$BOARD" ] && echo "No board.conf in $BOARD_DIR (mount the board directory there)" >&2
    exit 1
fi
# board.conf is parsed, not sourced: only BASE=<name> is used
BASE=$(sed -n 's/^[[:space:]]*BASE[[:space:]]*=[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}.*/\1/p' "$BOARD_DIR/board.conf" | tail -n 1)
if [ -z "$BASE" ] || [ ! -d "$FLASH_DIR/base/$BASE" ]; then
    bail "$BOARD_DIR/board.conf: invalid BASE '$BASE', available: $(list_dirs "$FLASH_DIR/base")"
fi
[ -d "$PARTS/EFI" ] || bail "$PARTS/EFI not found"
[ -f "$PARTS/rootfs.img" ] || bail "$PARTS/rootfs.img not found"
[ -f "$PARTS/config.img" ] || bail "$PARTS/config.img not found"
[ -d "$OUT" ] || bail "output directory $OUT not found"

# FAT images must use the same logical sector size as the UFS LUN (4KB):
# Linux refuses to mount a FAT whose sector size is smaller than the one of the
# block device, and so does the UEFI FAT driver.
#
# mkvfat <image> <size in KB> <label> [source dir]
mkvfat() {
    rm -f "$1"
    if [ "$2" -ge 262144 ]; then
        mkfs.vfat -F 32 -S "$SECTOR" -s 1 -n "$3" -C "$1" "$2" > /dev/null
    else
        mkfs.vfat -S "$SECTOR" -s 1 -n "$3" -C "$1" "$2" > /dev/null
    fi
    if [ -n "$4" ] && [ -n "$(ls -A "$4")" ]; then
        mcopy -i "$1" -s -p -Q -m "$4"/* ::/
    fi
    # Drop trailing zeros: unused FAT clusters don't need to be written to the
    # device, so the image only holds the filesystem metadata and the files,
    # while the filesystem still spans the whole partition.
    trim-image "$1" "$SECTOR"
}

# Partition layout without comments and blank lines, to compare layouts
normalize_conf() {
    sed -e 's/#.*//' -e 's/[[:space:]]\+/ /g' -e 's/^ //' -e 's/ $//' "$1" | grep -v '^$' || true
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ORIGINS="$WORK/origins"
: > "$ORIGINS"
# origin <origin> <path in the bundle>...
origin() {
    o="$1"
    shift
    for p in "$@"; do printf '%s\t%s\n' "$o" "$p" >> "$ORIGINS"; done
}

# Start from a clean output, keep the directory itself (it may be a mount point)
find "$OUT" -mindepth 1 -delete

echo "make-qcomflash: board $BOARD ($BOARD_DIR), base $BASE"
CUSTOM_REASONS=""

### Partition tables: the board's layout or the base's one for LUNs 1-5,
### EVE's for LUN 0
LAYOUT="$FLASH_DIR/layouts/$BASE.conf"
LAYOUT_SRC=base
SEED="eve-$BASE"
if [ -f "$BOARD_DIR/partitions/partitions.conf" ]; then
    LAYOUT="$BOARD_DIR/partitions/partitions.conf"
    if grep -Eq -- '^[[:space:]]*--partition.*--lun=0([^0-9]|$)' "$LAYOUT"; then
        bail "$LAYOUT: LUN 0 partitions are not allowed, LUN 0 is EVE's (eve-lun0.conf)"
    fi
    [ "$(grep -Ec -- '^[[:space:]]*--disk' "$LAYOUT")" = 1 ] || \
        bail "$LAYOUT: exactly one --disk line is required"
    normalize_conf "$LAYOUT" > "$WORK/layout.board"
    grep -Ev -- '--lun=0([^0-9]|$)' "$FLASH_DIR/layouts/$BASE.conf" > "$WORK/layout.base.raw"
    normalize_conf "$WORK/layout.base.raw" > "$WORK/layout.base"
    if cmp -s "$WORK/layout.board" "$WORK/layout.base"; then
        echo "make-qcomflash: the board's partition layout is the same as the base's"
    else
        echo "make-qcomflash: using the board's partition layout"
        LAYOUT_SRC=board
        SEED="eve-$BOARD"
        CUSTOM_REASONS="$CUSTOM_REASONS layout"
    fi
fi
mkdir -p "$WORK/gpt"
qcom-gen-gpt "$LAYOUT" "$WORK/gpt" "$SEED"

### Firmware: the base's files, then the board's flash/ over them
cp -a "$FLASH_DIR/base/$BASE/." "$OUT/"
(cd "$OUT" && find . -type f | sed 's#^\./##') | while read -r f; do origin base "$f"; done
REPLACED=""
ADDED=""
if [ -d "$BOARD_DIR/flash" ]; then
    (cd "$BOARD_DIR/flash" && find . -type f | sed 's#^\./##' | LC_ALL=C sort) > "$WORK/flash.list"
    while read -r f; do
        if [ -f "$OUT/$f" ]; then
            if cmp -s "$BOARD_DIR/flash/$f" "$OUT/$f"; then
                continue
            fi
            REPLACED="$REPLACED $f"
            origin board-replaced "$f"
        else
            ADDED="$ADDED $f"
            origin board-added "$f"
        fi
        mkdir -p "$OUT/$(dirname "$f")"
        cp "$BOARD_DIR/flash/$f" "$OUT/$f"
    done < "$WORK/flash.list"
    [ -z "$REPLACED" ] || echo "make-qcomflash: board files replacing the base's:$REPLACED"
    [ -z "$ADDED" ] || echo "make-qcomflash: board files added:$ADDED"
    [ -z "$REPLACED$ADDED" ] || CUSTOM_REASONS="$CUSTOM_REASONS flash"
fi
cp "$WORK"/gpt/* "$OUT/"

### dtb_a/dtb_b: firmware device tree (multi-DTB FIT), optional
DTB_SRC=none
if [ -f "$DTB_BIN" ]; then
    echo "make-qcomflash: using dtb.bin from $DTB_BIN"
    cp "$DTB_BIN" "$OUT/dtb.bin"
    origin override dtb.bin
    DTB_SRC=override
    CUSTOM_REASONS="$CUSTOM_REASONS dtb"
elif [ -f "$OUT/dtb.bin" ]; then
    DTB_SRC=board
elif grep -q 'filename="dtb.bin"' "$OUT"/rawprogram[0-9].xml; then
    echo "make-qcomflash: no dtb.bin provided, dtb_a/dtb_b will not be written"
    sed -i 's/filename="dtb.bin"/filename=""/' "$OUT"/rawprogram[0-9].xml
fi

### Build identification, written to the ESP (/EFI/BOOT/board.info) and to
### the bundle manifest. The board ID covers every file of the board directory.
BOARD_ID=$(cd "$BOARD_DIR" && find . -type f -print0 | LC_ALL=C sort -z | \
    xargs -0 -r sha256sum | sha256sum | cut -d ' ' -f 1)
CUSTOM=no
[ -z "$CUSTOM_REASONS" ] || CUSTOM=yes
EVE_VERSION=""
[ -f "$PARTS/eve_version" ] && EVE_VERSION=$(head -n 1 "$PARTS/eve_version")
{
    echo "# Generated by make-qcomflash"
    echo "board=$BOARD"
    echo "base=$BASE"
    echo "board_id=$BOARD_ID"
    echo "custom=$CUSTOM"
    echo "custom_reasons=${CUSTOM_REASONS# }"
    echo "layout=$LAYOUT_SRC"
    echo "flash_replaced=${REPLACED# }"
    echo "flash_added=${ADDED# }"
    echo "dtb=$DTB_SRC"
    echo "eve_version=$EVE_VERSION"
} > "$WORK/board.info"
echo "make-qcomflash: board ID $BOARD_ID, custom: $CUSTOM${CUSTOM_REASONS:+ (${CUSTOM_REASONS# })}"

### ESP ("efi", partition 1): same content as make-raw's do_efi()
mkdir -p "$WORK/efifs"
cp -Lr "$PARTS/EFI" "$WORK/efifs/EFI"
grub_efi=$(cd "$WORK/efifs" && echo EFI/BOOT/BOOT*EFI)
[ -f "$WORK/efifs/$grub_efi" ] || bail "no GRUB EFI binary in $PARTS/EFI/BOOT"
# Keep in sync with the grub.cfg embedded in pkg/mkimage-raw-efi/make-raw:
# select the GPT partition with the highest gptprio priority among the ones
# marked successful (IMGA/IMGB) and chainload the GRUB from it.
sed -e "s#@PATH_TO_GRUB@#$grub_efi#" > "$WORK/efifs/EFI/BOOT/grub.cfg" <<'EOF'
# this finds the next available bootable partition in GPT, with the highest priority
# and sets the value of the device it is on to $dev, and the uuid of the partition to $uuid
#
# to understand how this works, see pkg/grub/patches/0000-core-os-merge.patch
gptprio.next -d dev -u uuid

set root=$dev
chainloader ($dev)/@PATH_TO_GRUB@
boot
reboot
EOF
if [ -d "$PARTS/boot" ]; then
    cp -r "$PARTS/boot"/. "$WORK/efifs/"
fi

# Device settings, sourced by EVE's rootfs.cfg (pkg/grub) on every boot: the
# common Qualcomm settings followed by the board ones
grub_qcom="$FLASH_DIR/grub-qcom.cfg"
[ -f "$BOARD_DIR/grub-qcom.cfg" ] && grub_qcom="$BOARD_DIR/grub-qcom.cfg"
{
    echo "# Generated by make-qcomflash for board $BOARD (base $BASE)"
    echo
    cat "$grub_qcom"
    if [ -f "$BOARD_DIR/grub.cfg" ]; then
        echo
        cat "$BOARD_DIR/grub.cfg"
    fi
} > "$WORK/efifs/EFI/BOOT/grub-hv.cfg"
cp "$WORK/board.info" "$WORK/efifs/EFI/BOOT/board.info"
if [ -d "$BOARD_DIR/dtb" ]; then
    mkdir -p "$WORK/efifs/dtb"
    cp -r "$BOARD_DIR/dtb"/. "$WORK/efifs/dtb/"
fi
mkvfat "$OUT/efi.img" "$EFI_PART_KB" EVE "$WORK/efifs"

### Reserved ESP-B: empty FAT32, like make-raw's do_efi_b()
mkdir -p "$WORK/empty"
mkvfat "$OUT/efi_b.img" "$EFI_PART_KB" EVE "$WORK/empty"

### CONFIG: re-create config.img with 4KB sectors, keeping its contents
mkdir -p "$WORK/config"
if [ -n "$(mdir -i "$PARTS/config.img" -b ::/ 2>/dev/null)" ]; then
    mcopy -i "$PARTS/config.img" -s -p -m ::/* "$WORK/config/"
fi
mkvfat "$OUT/config.img" "$CONF_PART_KB" EVE "$WORK/config"

### IMGA: EVE rootfs (squashfs/ext4, sector size agnostic)
cp "$PARTS/rootfs.img" "$OUT/rootfs.img"
origin eve efi.img efi_b.img config.img rootfs.img

### Final checks (referenced files, sizes, unused files) and manifest
qcom-bundle-check "$OUT" "$ORIGINS" "$WORK/board.info" || \
    bail "invalid flash bundle, see the errors above"

echo "make-qcomflash: flash bundle ready in $OUT"
