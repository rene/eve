"""Check a QDL flash bundle and write its manifest.

Usage: qcom-bundle-check <bundle dir> <origins file> <board.info>

Checks, for the files referenced by rawprogram*.xml:
  - every referenced file is in the bundle (error)
  - every file fits in the partition it is written to (error), except for
    partitions grown at flash time (size 0), sparse images and zeros_* (used
    by the Qualcomm layouts to wipe partitions)
  - files of the bundle that nothing flashes (warning)

Writes bundle-manifest.txt and bundle-manifest.json in the bundle: the
board.info settings, and for every file its size, sha256, origin and the
partitions it is written to.

origins file: one "<origin>\t<path>" line per file, the last one wins. Files
not listed are reported as "generated".
"""

import fnmatch
import glob
import hashlib
import json
import os
import sys
import xml.etree.ElementTree as ET

MANIFEST_TXT = "bundle-manifest.txt"
MANIFEST_JSON = "bundle-manifest.json"

# Files that are in the bundle on purpose but not referenced by rawprogram
NOT_FLASHED = [
    "prog_*", "LICENSE*", "sail_nor/*", "partitions.*", "zeros_*",
    "gpt_both*", "rawprogram*.xml", "patch*.xml", "bundle-*",
]


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_kv(path):
    info = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, val = line.partition("=")
                info[key.strip()] = val.strip()
    return info


def read_origins(path):
    origins = {}
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if "\t" in line:
                origin, _, rel = line.partition("\t")
                origins[os.path.normpath(rel)] = origin
    return origins


def main():
    if len(sys.argv) != 4:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 1
    bundle, origins_file, info_file = sys.argv[1:]
    info = read_kv(info_file)
    origins = read_origins(origins_file)

    errors = []
    warnings = []
    flashed = {}
    for xml in sorted(glob.glob(os.path.join(bundle, "rawprogram[0-9]*.xml"))):
        for prog in ET.parse(xml).getroot().iter("program"):
            name = prog.get("filename", "")
            if not name:
                continue
            rel = os.path.normpath(name)
            lun = prog.get("physical_partition_number", "?")
            label = prog.get("label", "")
            flashed.setdefault(rel, []).append(f"{lun}:{label}")
            path = os.path.join(bundle, rel)
            if not os.path.isfile(path):
                errors.append(f"{rel}: referenced by {os.path.basename(xml)} "
                              f"(LUN {lun}, {label}) but not in the bundle")
                continue
            sectors = int(prog.get("num_partition_sectors", "0") or "0")
            sector_size = int(prog.get("SECTOR_SIZE_IN_BYTES", "4096"))
            # zeros_* wipe partitions, qdl writes only the partition size
            if sectors == 0 or prog.get("sparse", "false").lower() == "true" \
                    or fnmatch.fnmatch(os.path.basename(rel), "zeros_*"):
                continue
            size = os.path.getsize(path)
            if size > sectors * sector_size:
                errors.append(f"{rel}: {size} bytes, does not fit in LUN {lun} "
                              f"partition {label} ({sectors * sector_size} bytes)")

    files = {}
    for root, dirs, names in os.walk(bundle):
        dirs.sort()
        for name in sorted(names):
            path = os.path.join(root, name)
            rel = os.path.relpath(path, bundle)
            if rel in (MANIFEST_TXT, MANIFEST_JSON):
                continue
            files[rel] = {
                "size": os.path.getsize(path),
                "sha256": sha256(path),
                "origin": origins.get(rel, "generated"),
                "partitions": flashed.get(rel, []),
            }
            if rel not in flashed and \
                    not any(fnmatch.fnmatch(rel, p) for p in NOT_FLASHED):
                warnings.append(f"{rel}: not written to any partition "
                                f"(origin {files[rel]['origin']})")

    with open(os.path.join(bundle, MANIFEST_JSON), "w") as f:
        json.dump({"board": info, "files": files}, f, indent=2, sort_keys=True)
        f.write("\n")
    with open(os.path.join(bundle, MANIFEST_TXT), "w") as f:
        f.write("# QDL flash bundle manifest, generated by make-qcomflash\n")
        for key, val in info.items():
            f.write(f"# {key}={val}\n")
        f.write("#\n# sha256 size origin partitions(LUN:label) file\n")
        for rel, meta in files.items():
            parts = ",".join(meta["partitions"]) or "-"
            f.write(f"{meta['sha256']} {meta['size']} {meta['origin']} "
                    f"{parts} {rel}\n")

    for w in warnings:
        print(f"make-qcomflash: WARNING: {w}", file=sys.stderr)
    for e in errors:
        print(f"make-qcomflash: ERROR: {e}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
