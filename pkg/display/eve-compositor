#
# Supervisor for the host Wayland compositor: the compositor that owns the
# GPU and puts each application's virtio-gpu scanout on a physical connector.
#
# linuxkit starts this container at boot and keeps it running, but the
# compositor itself must only run when pillar says so — it cannot share a
# card with a GPU passed through to a guest. pillar's displaymgr lives in a
# different container and so cannot fork or signal weston directly; instead
# the two agree on files in the shared /run/display directory:
#
#   enabled     written by displaymgr; present means "run the compositor"
#   placement   written by displaymgr; the placement rules
#   weston.ini  written here, regenerated whenever placement changes
#   wayland-0   written by weston; present means "the compositor is up"
#   weston.pid  written here, for diagnostics
#
# Driving it through files also means restarting pillar does not disturb a
# running compositor, and so does not disturb any application scanning out
# through it.

set -u

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/display}"
SOCKET="${WAYLAND_DISPLAY:-wayland-0}"
ENABLED_FILE="$RUNTIME_DIR/enabled"
PLACEMENT_FILE="${EVE_PLACEMENT_FILE:-$RUNTIME_DIR/placement}"
CONFIG="$RUNTIME_DIR/weston.ini"
PIDFILE="$RUNTIME_DIR/weston.pid"
LOG="$RUNTIME_DIR/weston.log"
POLL_INTERVAL=1

mkdir -p "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"
export XDG_RUNTIME_DIR="$RUNTIME_DIR"
# There is no logind on EVE. libseat's builtin backend opens the DRM and
# input devices directly, which works because this container runs as root
# with the real device nodes.
export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-builtin}"

WESTON_PID=""
PLACEMENT_STAMP=""

log() {
    echo "$(date -Iseconds) eve-compositor: $*"
}

# Generate weston.ini from the placement file.
#
# kiosk-shell places a client on the output whose [output] section lists its
# app-id in "app-ids" (weston.ini(5): "A comma separated list of the IDs of
# applications to place on this output... Currently, this option is
# supported by kiosk-shell"). So placement is expressed per output, with the
# app-ids gathered into one comma-separated value - not as a per-app
# section.
#
# LIMITATION: the mapping is app-id to output, so it cannot pin scanout N of
# one app to output N. A domain given several connectors gets its first
# surface placed and the rest laid out by the shell's default. Driving
# several scanouts of one qemu process to specific outputs needs a
# compositor with a real control interface; until then, give each
# application one connector.
generate_config() {
    cat > "$CONFIG" <<CORE
# Generated by eve-compositor from $PLACEMENT_FILE. Do not edit.
[core]
# Bare names, no "-backend.so"/"-shell.so" suffix: weston 13 changed the
# accepted spelling of these two keys, and weston.ini(5) for the packaged
# 14.0.2 lists them as drm/headless/... and desktop/fullscreen/ivi/kiosk.
# (modules= still takes a .so name - the convention differs per key.)
shell=kiosk
backend=drm
require-input=false
idle-time=0

[libinput]
enable-tap=true
CORE

    [ -r "$PLACEMENT_FILE" ] || return 0

    # One [output] section per connector, carrying every app-id destined for
    # it, so the records have to be grouped rather than emitted as read.
    # The scanout field is ignored; see the LIMITATION above.
    awk '
        /^[ \t]*(#|$)/ { next }
        NF < 3 { next }
        {
            output = $3
            sub(/^card[0-9]*-/, "", output)
            if (output in ids) {
                ids[output] = ids[output] "," $1
            } else {
                order[++n] = output
                ids[output] = $1
            }
        }
        END {
            for (i = 1; i <= n; i++) {
                o = order[i]
                printf "\n[output]\nname=%s\nmode=preferred\napp-ids=%s\n", o, ids[o]
            }
        }
    ' "$PLACEMENT_FILE" >> "$CONFIG"
}

# A content hash, not an mtime: displaymgr rewrites the file by rename, and
# an unchanged rewrite must not cost every monitor a re-layout.
placement_stamp() {
    if [ -r "$PLACEMENT_FILE" ]; then
        md5sum < "$PLACEMENT_FILE"
    else
        echo "absent"
    fi
}

compositor_running() {
    [ -n "$WESTON_PID" ] && kill -0 "$WESTON_PID" 2>/dev/null
}

start_compositor() {
    generate_config
    PLACEMENT_STAMP="$(placement_stamp)"
    rm -f "$RUNTIME_DIR/$SOCKET"

    weston \
        --config="$CONFIG" \
        --socket="$SOCKET" \
        --log="$LOG" \
        --continue-without-input &
    WESTON_PID=$!
    echo "$WESTON_PID" > "$PIDFILE"
    log "started weston, pid $WESTON_PID"
}

# Stop weston and wait for it to actually exit. Waiting is the point: a
# compositor killed while it is DRM master can leave the card in a state
# where neither the console framebuffer nor a later VFIO bind can drive it,
# and displaymgr treats the socket disappearing as "the card is free".
stop_compositor() {
    compositor_running || { cleanup_files; return; }

    log "stopping weston, pid $WESTON_PID"
    kill -TERM "$WESTON_PID" 2>/dev/null
    i=0
    while [ "$i" -lt 50 ] && kill -0 "$WESTON_PID" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$WESTON_PID" 2>/dev/null; then
        log "weston did not exit on SIGTERM, killing"
        kill -KILL "$WESTON_PID" 2>/dev/null
        wait "$WESTON_PID" 2>/dev/null
    fi
    cleanup_files
}

cleanup_files() {
    WESTON_PID=""
    rm -f "$PIDFILE" "$RUNTIME_DIR/$SOCKET"
}

shutdown() {
    stop_compositor
    exit 0
}
trap shutdown TERM INT

log "supervising; waiting for $ENABLED_FILE"
while true; do
    if [ -e "$ENABLED_FILE" ]; then
        if ! compositor_running; then
            # Reap a weston that exited on its own before restarting it, so
            # a crash loop does not accumulate zombies.
            [ -n "$WESTON_PID" ] && { wait "$WESTON_PID" 2>/dev/null; cleanup_files; }
            start_compositor
        elif [ "$(placement_stamp)" != "$PLACEMENT_STAMP" ]; then
            log "placement changed, reloading"
            generate_config
            PLACEMENT_STAMP="$(placement_stamp)"
            kill -HUP "$WESTON_PID" 2>/dev/null
        fi
    else
        stop_compositor
    fi
    sleep "$POLL_INTERVAL"
done
