diff -uprN a/ftpm-helper/custom.mk b/ftpm-helper/custom.mk
--- a/ftpm-helper/custom.mk	1970-01-01 01:00:00.000000000 +0100
+++ b/ftpm-helper/custom.mk	2026-05-08 12:51:39.325936090 +0200
@@ -0,0 +1,26 @@
+# Set in make
+
+OPTEE_CLIENT_EXPORT = /out/usr
+
+O=output
+
+# Uncomment the following if the TEE has the fTPM helper PTA.
+# This is necessary for early TAs, because the helper PTA informs
+# when RPC calls to linux are available.  It is also necessary for
+# activation.
+USE_FTPM_PTA = y
+
+
+ifeq ($(FTPM_TEST_MODE),y)
+# Uncomment the following to test activation.
+# Requires that USE_FTPM_PTA be enabled.
+SEQ_FTPM_TEST = y
+
+# Uncomment the following to test activation.
+# Requires that SEQ_FTPM_TEST be enabled.
+JETSON_FTPM_HELPER_INJECT_SN = y
+endif
+
+# Uncomment the following to enable AI protection
+# Requires CLR_ASN1_DIR to point to the clr_asn1 library
+#CFG_AI_PROTECT = y
diff -uprN a/ftpm-helper/host/Makefile b/ftpm-helper/host/Makefile
--- a/ftpm-helper/host/Makefile	2026-05-08 12:49:47.058425363 +0200
+++ b/ftpm-helper/host/Makefile	2026-05-08 12:51:39.321441946 +0200
@@ -15,8 +15,7 @@ CFLAGS += -I./include
 CFLAGS += -I./mbedtls/include -I./jansson/src
 CFLAGS += -I$(OPTEE_CLIENT_EXPORT)/include
 CFLAGS += -fstack-protector-strong
-LDADD += -L./jansson/src/.libs -ljansson
-LDADD += -L./mbedtls/library -lmbedtls -lmbedx509 -lmbedcrypto
+LDADD += -ljansson -lmbedtls -lmbedx509 -lmbedcrypto -largp
 LDADD += -lteec -L$(OPTEE_CLIENT_EXPORT)/lib -L./lib
 
 ifeq ($(CFG_SEQ_FTPM_TEST),y)
